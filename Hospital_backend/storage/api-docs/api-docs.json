        "/api/rendez-vous": {
            "get": {
                "tags": [
                    "Appointments"
                ],
                "summary": "List all appointments",
                "description": "Retrieve a list of appointments with optional filtering",
                "operationId": "1280f5565a41e2068f127a52c040212d",
                "parameters": [
                    {
                        "name": "statut",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "prevu",
                                "confirme",
                                "en_cours",
                                "effectue",
                                "annule",
                                "reporte"
                            ]
                        }
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "description": "Filter by date (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "medecin_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "patient_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of appointments"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Appointments"
                ],
                "summary": "Book a new appointment",
                "description": "Create a new appointment. **Note:** A confirmation email is automatically sent to the patient upon success.",
                "operationId": "10203a1b29f6a060e7b740c1eecd32c5",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "patient_id",
                                    "medecin_id",
                                    "date_heure",
                                    "motif",
                                    "statut"
                                ],
                                "properties": {
                                    "patient_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "medecin_id": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "medecin_remplacant_id": {
                                        "description": "Optional substitute doctor ID",
                                        "type": "integer",
                                        "example": 3,
                                        "nullable": true
                                    },
                                    "date_heure": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-12-25 10:00:00"
                                    },
                                    "motif": {
                                        "type": "string",
                                        "example": "Routine Checkup"
                                    },
                                    "statut": {
                                        "type": "string",
                                        "enum": [
                                            "prevu",
                                            "confirme"
                                        ],
                                        "example": "prevu"
                                    },
                                    "observation": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Appointment created and email sent"
                    },
                    "422": {
                        "description": "Validation Error (e.g. duplicate slot)"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
